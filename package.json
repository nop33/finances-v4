{
  "name": "finances-v4",
  "version": "0.1.0",
  "description": "Personal monthly expense tracker for Zürich",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "finances": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc && mkdir -p dist/test-fixtures && cp src/test-fixtures/*.json dist/test-fixtures/",
    "dev": "tsc --watch",
    "pretest": "npm run build",
    "test": "node --test --experimental-test-coverage dist/*.test.js dist/**/*.test.js",
    "cli": "node dist/cli.js"
  },
  "keywords": ["finance", "expenses", "tracking"],
  "author": "Ilias Trichopoulos <hlias.nop@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "better-sqlite3": "^11.5.0",
    "papaparse": "^5.4.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.9.0",
    "@types/papaparse": "^5.3.15",
    "typescript": "^5.6.3"
  }
}
